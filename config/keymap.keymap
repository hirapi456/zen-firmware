#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <21 22>;
        };

        mddle-click {
            bindings = <&mkp MCLK>;
            key-positions = <20 21>;
        };

        next-pagej {
            bindings = <&mkp MB5>;
            key-positions = <34 35>;
        };

        prev-page {
            bindings = <&mkp MB4>;
            key-positions = <34 33>;
        };

        down {
            bindings = <&msc MOVE_Y(-10)>;
            key-positions = <7 8>;
        };

        up {
            bindings = <&msc MOVE_Y(10)>;
            key-positions = <8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp Q       &kp W         &kp E     &kp R           &kp T      &kp Y                    &kp U      &kp I           &kp O           &kp P           &kp BSPC
&kp TAB    &kp A       &kp S         &kp D     &kp F           &kp G      &kp H                    &kp J      &kp K           &kp L           &kp MINUS       &kp ENTER
&kp LSHFT  &kp Z       &kp X         &kp C     &kp V           &kp B      &kp LANG_ZENKAKUHANKAKU  &kp TILDE  &kp N           &kp M           &mt RPAR COMMA  &mt LEFT_PARENTHESIS DOT  &kp UP_ARROW  &mt PERCENT QUESTION
&kp LCTRL  &kp ESCAPE  &kp LEFT_WIN  &kp LALT  &kp INT_HENKAN  &kp SPACE  &mo 3                    &mo 2      &kp C_AL_FILES  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2   &kp N3    &kp N4      &kp N5     &kp N6         &kp N7       &kp N8       &kp N9          &kp N0                 &kp DELETE
&trans      &kp EXCL  &kp DQT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp AMPERSAND  &kp AT_SIGN  &kp INT_YEN  &kp SEMICOLON   &kp RIGHT_PARENTHESIS  &trans
&trans      &trans    &trans   &trans    &trans      &trans     &trans         &trans       &kp TILDE    &kp LEFT_BRACE  &kp LBKT               &kp RBKT    &kp RIGHT_BRACKET  &kp SLASH
&trans      &trans    &trans   &trans    &trans      &trans     &trans         &trans       &trans       &trans          &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp KP_DIVIDE  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &kp DQT        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans         &kp END          &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans         &kp KP_NUMBER_0  &kp KP_DOT       &kp UNDER        &kp KP_ENTER
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
